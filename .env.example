# Copy to data/config.env and fill in. Never commit.
# Get these from https://developer.kroger.com/ -> your app

# REQUIRED. From the Kroger Developer Portal.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# MUST exactly match the "Redirect URI" configured in the Kroger portal,
# including the port. Default: http://localhost:3000
KROGER_REDIRECT_URI=http://localhost:3000

# PROD for your real shopper account. CERT is Kroger's sandbox.
KROGER_ENV=PROD

# Your default store
KROGER_ZIP=
KROGER_CHAIN=Kroger
KROGER_LOCATION_ID=
